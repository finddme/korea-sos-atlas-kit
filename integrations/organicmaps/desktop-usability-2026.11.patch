+// Korea SOS Atlas Kit: CPU rendering for PCs without a usable graphics driver.
+// drape calls opengl32.dll directly, so Qt's opengl32sw.dll cannot serve it: the
+// map stays white. Instead Mesa llvmpipe is loaded from <exe dir>\mesa under the
+// module name opengl32.dll before anything binds it (opengl32.dll is delay-loaded,
+// see qt/CMakeLists.txt). drape and Qt (QT_OPENGL=desktop) then both use it.
+enum class AtlasSoftwareGL { Off, Loaded, Failed, TooLate };
+
+AtlasSoftwareGL LoadAtlasSoftwareGL()
+{
+  if (qEnvironmentVariableIntValue("SOS_ATLAS_SOFTWARE_GL") != 1)
+    return AtlasSoftwareGL::Off;
+  if (::GetModuleHandleW(L"opengl32.dll") != nullptr)
+    return AtlasSoftwareGL::TooLate;
+  wchar_t exe[MAX_PATH];
+  DWORD const n = ::GetModuleFileNameW(nullptr, exe, MAX_PATH);
+  if (n == 0 || n >= MAX_PATH)
+    return AtlasSoftwareGL::Failed;
+  std::wstring path(exe, n);
+  path.resize(path.find_last_of(L"\\/") + 1);
+  path += L"mesa\\opengl32.dll";
+  if (::LoadLibraryExW(path.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH) == nullptr)
+    return AtlasSoftwareGL::Failed;
+  qputenv("QT_OPENGL", "desktop");
+  return AtlasSoftwareGL::Loaded;
+}
