+class AtlasTranslator final : public QTranslator
+{
+  QJsonObject m_strings;
+public:
+  AtlasTranslator() { QFile f(":/atlas/ko.json"); if (f.open(QIODevice::ReadOnly)) m_strings = QJsonDocument::fromJson(f.readAll()).object(); }
