diff --git a/libs/platform/atlas_offline.hpp b/libs/platform/atlas_offline.hpp
new file mode 100644
index 0000000000..b58925669d
--- /dev/null
+++ b/libs/platform/atlas_offline.hpp
@@ -0,0 +1,20 @@
+// Korea SOS Atlas Kit modification, 2026-11-25. Apache-2.0; upstream notices retained.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+
+namespace platform
+{
+// The kit launches the viewer with SOS_ATLAS_OFFLINE=1. The viewer then makes no
+// network requests at all: map downloads, update checks, server pings and edit
+// uploads fail before any socket is opened, and the download UI is hidden.
+inline bool AtlasOffline()
+{
+  static bool const offline = []
+  {
+    char const * v = std::getenv("SOS_ATLAS_OFFLINE");
+    return v != nullptr && std::strcmp(v, "1") == 0;
+  }();
+  return offline;
+}
+}  // namespace platform
diff --git a/libs/platform/http_client_qt.cpp b/libs/platform/http_client_qt.cpp
index 627ae2595f..684d486fb7 100644
--- a/libs/platform/http_client_qt.cpp
+++ b/libs/platform/http_client_qt.cpp
@@ -1,5 +1,7 @@
 #include "platform/http_client_qt.hpp"
 
+#include "platform/atlas_offline.hpp"
+
 #include "base/logging.hpp"
 
 #include <QBuffer>
@@ -528,6 +530,19 @@ HttpClient::RequestHandle HttpClient::RunHttpRequestAsync(CompletionHandler hand
   RequestHandle handle;
   handle.m_impl = std::make_shared<RequestHandle::Impl>();
 
+  // Korea SOS Atlas Kit offline mode: fail like an unreachable network, before any socket.
+  if (AtlasOffline())
+  {
+    LOG(LINFO, ("Offline mode: network request refused:", m_urlRequested));
+    if (handler)
+    {
+      Result result;
+      result.m_errorCode = static_cast<int>(QNetworkReply::NetworkSessionFailedError);
+      handler(std::move(result));
+    }
+    return handle;
+  }
+
   QNetworkRequest request(QUrl(QString::fromStdString(m_urlRequested)));
 
   // TODO(klahr): Keep only setTransferTimeout() when Qt 5 is dropped.
