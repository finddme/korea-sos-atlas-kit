@@ -0,0 +1,335 @@
+// Korea SOS Atlas Kit modification, 2026-11-26. Apache-2.0; upstream notices retained.
+#include "qt/atlas_nearby.hpp"
+
+#include "map/bookmark.hpp"
+#include "map/bookmark_manager.hpp"
+#include "map/framework.hpp"
+#include "map/place_page_info.hpp"
+#include "map/routing_mark.hpp"
+
+#include "geometry/distance_on_sphere.hpp"
+#include "geometry/mercator.hpp"
+
+#include <QtCore/QElapsedTimer>
+#include <QtCore/QTimer>
+#include <QtGui/QIcon>
+#include <QtGui/QPainter>
+#include <QtGui/QPainterPath>
+#include <QtGui/QPixmap>
+#include <QtWidgets/QComboBox>
+#include <QtWidgets/QDockWidget>
+#include <QtWidgets/QLabel>
+#include <QtWidgets/QListWidget>
+#include <QtWidgets/QPushButton>
+#include <QtWidgets/QVBoxLayout>
+
+#include <algorithm>
+#include <limits>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace qt
+{
+namespace
+{
+// Document name written by the kit (src/map_places.rs): "대피시설 · <province>".
+constexpr char kListPrefix[] = "대피시설 · ";
+constexpr size_t kShown = 30;
+// The list follows an origin once it has moved this far.
+constexpr double kResortMeters = 30;
+
+enum Kind { kAll = 0, kShelter, kWater };
+
+struct Place
+{
+  kml::MarkId m_id;
+  m2::PointD m_pivot;
+  QString m_name;
+  QString m_address;
+  bool m_water;
+};
+
+QString Distance(double meters)
+{
+  if (meters < 1000)
+    return QString("%1 m").arg(static_cast<int>(meters + 0.5));
+  return QString("%1 km").arg(meters / 1000, 0, 'f', meters < 10000 ? 2 : 1);
+}
+
+class NearbyPanel final : public QWidget
+{
+public:
+  NearbyPanel(QWidget * parent, Framework & framework) : QWidget(parent), m_framework(framework)
+  {
+    auto * layout = new QVBoxLayout(this);
+    m_kind = new QComboBox(this);
+    m_kind->setObjectName("atlasNearbyKind");
+    m_kind->addItem(tr("All facilities"), kAll);
+    m_kind->addItem(tr("Civil defence shelters"), kShelter);
+    m_kind->addItem(tr("Emergency water"), kWater);
+    connect(m_kind, &QComboBox::currentIndexChanged, this, [this](int) { m_dirty = true; Tick(); });
+    m_origin = new QLabel(this);
+    m_origin->setWordWrap(true);
+    m_list = new QListWidget(this);
+    m_list->setObjectName("atlasNearbyList");
+    m_list->setWordWrap(true);
+    m_list->setAlternatingRowColors(true);
+    connect(m_list, &QListWidget::itemClicked, this, [this](QListWidgetItem * item) { Show(item); });
+    connect(m_list, &QListWidget::itemDoubleClicked, this, [this](QListWidgetItem * item) { SetDestination(item); });
+    m_destination = new QPushButton(tr("Set as destination"), this);
+    m_destination->setObjectName("atlasNearbyDestination");
+    m_destination->setEnabled(false);
+    connect(m_list, &QListWidget::currentItemChanged, this,
+            [this](QListWidgetItem * item, QListWidgetItem *) { m_destination->setEnabled(item != nullptr); });
+    connect(m_destination, &QPushButton::clicked, this, [this] { SetDestination(m_list->currentItem()); });
+    auto * help = new QLabel(tr("Click to show it on the map; double-click to set it as the destination."), this);
+    help->setWordWrap(true);
+    auto * notice = new QLabel(tr("Public data. Whether a place is open or has water is not confirmed; "
+                                  "follow official guidance first."), this);
+    notice->setWordWrap(true);
+    layout->addWidget(m_kind);
+    layout->addWidget(m_origin);
+    layout->addWidget(m_list, 1);
+    layout->addWidget(m_destination);
+    layout->addWidget(help);
+    layout->addWidget(notice);
+
+    auto * timer = new QTimer(this);
+    connect(timer, &QTimer::timeout, this, [this] { Tick(); });
+    timer->start(700);
+    Tick();
+  }
+
+private:
+  void Load()
+  {
+    auto const & bm = m_framework.GetBookmarkManager();
+    m_places.clear();
+    for (auto const groupId : bm.GetUnsortedBmGroupsIdList())
+    {
+      if (!bm.GetCategoryName(groupId).starts_with(kListPrefix))
+        continue;
+      for (auto const markId : bm.GetUserMarkIds(groupId))
+      {
+        auto const * mark = bm.GetBookmark(markId);
+        if (!mark)
+          continue;
+        auto const name = QString::fromStdString(mark->GetPreferredName());
+        m_places.push_back({markId, mark->GetPivot(), name, QString::fromStdString(mark->GetDescription()),
+                            name.startsWith(QString::fromUtf8("[비상급수]"))});
+      }
+    }
+    m_dirty = true;
+  }
+
+  void Tick()
+  {
+    if (!isVisible())
+      return;
+    auto const & bm = m_framework.GetBookmarkManager();
+    if (bm.IsAsyncLoadingInProgress())
+    {
+      m_origin->setText(tr("Loading saved places..."));
+      return;
+    }
+    if (bm.GetBmGroupsCount() != m_groups)
+    {
+      m_groups = bm.GetBmGroupsCount();
+      Load();
+    }
+    if (m_places.empty())
+    {
+      m_list->clear();
+      m_origin->setText(tr("No facility lists. Open the map from Korea SOS Atlas to add them."));
+      return;
+    }
+
+    // The place the user searched for or clicked on the map. Facilities picked from this list
+    // do not replace it, so the list keeps its origin while the user looks through it.
+    if (!m_framework.HasPlacePageInfo())
+      m_selected.reset();
+    else
+    {
+      auto const & info = m_framework.GetCurrentPlacePageInfo();
+      bool const facility = info.IsBookmark() && bm.GetCategoryName(info.GetBookmarkCategoryId()).starts_with(kListPrefix);
+      if (!facility)
+      {
+        m_selected = info.GetMercator();
+        m_selectedTitle = QString::fromStdString(info.GetTitle());
+      }
+    }
+
+    // Origin: the chosen route start, the selected place, the device position, the map centre.
+    std::optional<m2::PointD> origin;
+    QString label;
+    for (auto const & p : m_framework.GetRoutingManager().GetRoutePoints())
+    {
+      if (p.m_pointType != RouteMarkType::Start)
+        continue;
+      origin = p.m_position;
+      label = p.m_isMyPosition || p.m_title.empty() ? tr("Distance from: route start")
+                                                    : tr("Distance from: route start (%1)")
+                                                          .arg(QString::fromStdString(p.m_title));
+    }
+    if (!origin && m_selected)
+    {
+      origin = *m_selected;
+      label = m_selectedTitle.isEmpty() ? tr("Distance from: selected place")
+                                        : tr("Distance from: selected place (%1)").arg(m_selectedTitle);
+    }
+    if (!origin)
+    {
+      if (auto const position = m_framework.GetCurrentPosition())
+      {
+        origin = *position;
+        label = tr("Distance from: current position (GPS)");
+      }
+    }
+    if (!origin)
+    {
+      auto const center = m_framework.GetViewportCenter();
+      bool const settled = center == m_lastCenter;
+      m_lastCenter = center;
+      // Wait until the map stops moving, and keep the list when the map only moved to
+      // the place picked from it.
+      if (!settled)
+        return;
+      if (m_pickTimer.isValid())
+      {
+        // A place picked from the list moved the map (and the place page may shift it).
+        // Keep the list until the user moves the map away from where that move ended.
+        if (m_pickTimer.elapsed() < 2500)
+          return;
+        m_pickTimer.invalidate();
+        m_heldCenter = center;
+      }
+      if (m_heldCenter && mercator::DistanceOnEarth(center, *m_heldCenter) < kResortMeters)
+        return;
+      m_heldCenter.reset();
+      origin = center;
+      label = tr("Distance from: map centre. Move the map to search another area.");
+    }
+    if (!m_dirty && label == m_label && m_sortedAt && mercator::DistanceOnEarth(*origin, *m_sortedAt) < kResortMeters)
+      return;
+    m_dirty = false;
+    m_label = label;
+    m_sortedAt = origin;
+    m_origin->setText(label);
+    Sort(*origin);
+  }
+
+  void Sort(m2::PointD const & origin)
+  {
+    auto const kind = m_kind->currentData().toInt();
+    auto const from = mercator::ToLatLon(origin);
+    std::vector<std::pair<double, Place const *>> found;
+    found.reserve(m_places.size());
+    for (auto const & p : m_places)
+    {
+      if ((kind == kShelter && p.m_water) || (kind == kWater && !p.m_water))
+        continue;
+      found.emplace_back(ms::DistanceOnEarth(from, mercator::ToLatLon(p.m_pivot)), &p);
+    }
+    auto const n = std::min(found.size(), kShown);
+    std::partial_sort(found.begin(), found.begin() + n, found.end(),
+                      [](auto const & a, auto const & b) { return a.first < b.first; });
+
+    auto const selected = m_list->currentItem() ? m_list->currentItem()->data(Qt::UserRole) : QVariant();
+    m_list->clear();
+    for (size_t i = 0; i < n; ++i)
+    {
+      auto const & [meters, p] = found[i];
+      auto * item = new QListWidgetItem(QString("%1 · %2\n%3").arg(Distance(meters), p->m_name, p->m_address), m_list);
+      item->setData(Qt::UserRole, QVariant::fromValue<qulonglong>(p->m_id));
+      if (selected.isValid() && selected.toULongLong() == p->m_id)
+        m_list->setCurrentItem(item);
+    }
+  }
+
+  Place const * Find(QListWidgetItem * item) const
+  {
+    if (!item)
+      return nullptr;
+    auto const id = static_cast<kml::MarkId>(item->data(Qt::UserRole).toULongLong());
+    auto const it = std::find_if(m_places.cbegin(), m_places.cend(), [id](Place const & p) { return p.m_id == id; });
+    return it == m_places.cend() ? nullptr : &*it;
+  }
+
+  void Show(QListWidgetItem * item)
+  {
+    auto const * place = Find(item);
+    if (!place || !m_framework.GetBookmarkManager().GetBookmark(place->m_id))
+      return;
+    m_pickTimer.start();
+    m_framework.ShowBookmark(place->m_id);
+  }
+
+  void SetDestination(QListWidgetItem * item)
+  {
+    auto const * place = Find(item);
+    if (!place)
+      return;
+    RouteMarkData target;
+    target.m_pointType = RouteMarkType::Finish;
+    target.m_position = place->m_pivot;
+    target.m_title = place->m_name.toStdString();
+    auto & rm = m_framework.GetRoutingManager();
+    rm.AddRoutePoint(std::move(target), false /* optimize */);
+    if (rm.GetRoutePoints().size() >= 2)
+      rm.BuildRoute();
+  }
+
+  Framework & m_framework;
+  QComboBox * m_kind = nullptr;
+  QLabel * m_origin = nullptr;
+  QListWidget * m_list = nullptr;
+  QPushButton * m_destination = nullptr;
+  std::vector<Place> m_places;
+  size_t m_groups = std::numeric_limits<size_t>::max();
+  bool m_dirty = true;
+  QString m_label;
+  m2::PointD m_lastCenter;
+  std::optional<m2::PointD> m_sortedAt;
+  std::optional<m2::PointD> m_heldCenter;
+  std::optional<m2::PointD> m_selected;
+  QString m_selectedTitle;
+  QElapsedTimer m_pickTimer;
+};
+}  // namespace
+
+QIcon AtlasShelterIcon()
+{
+  QPixmap pixmap(48, 48);
+  pixmap.fill(Qt::transparent);
+  QPainter p(&pixmap);
+  p.setRenderHint(QPainter::Antialiasing);
+  QPainterPath house;
+  house.moveTo(24, 5);
+  house.lineTo(44, 22);
+  house.lineTo(38, 22);
+  house.lineTo(38, 43);
+  house.lineTo(10, 43);
+  house.lineTo(10, 22);
+  house.lineTo(4, 22);
+  house.closeSubpath();
+  p.setPen(QPen(QColor(150, 20, 20), 2));
+  p.setBrush(QColor(214, 40, 40));
+  p.drawPath(house);
+  p.setPen(Qt::NoPen);
+  p.setBrush(Qt::white);
+  p.drawRect(21, 25, 6, 14);  // a plus sign: a place to go to
+  p.drawRect(17, 29, 14, 6);
+  return QIcon(pixmap);
+}
