 namespace
 {
+// "강남역" -> "강남"; empty unless the query is one word ending in 역.
+std::string AtlasStationStem(QString const & text)
+{
+  auto const t = text.trimmed();
+  if (t.size() < 2 || t.contains(' ') || !t.endsWith(QString::fromUtf8("역")))
+    return {};
+  return t.chopped(1).toStdString();
+}
+
+bool IsAtlasStation(search::Result const & r, std::string const & stem)
+{
+  if (r.GetResultType() != search::Result::Type::Feature)
+    return false;
+  auto const & name = r.GetString();
+  if (name != stem && name != stem + "역")
+    return false;
+  auto const type = classif().GetReadableObjectName(r.GetFeatureType());
+  return type.starts_with("railway-station") || type.starts_with("railway-halt");
+}
