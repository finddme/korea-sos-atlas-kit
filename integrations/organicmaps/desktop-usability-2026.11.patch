diff --git a/qt/atlas_location.hpp b/qt/atlas_location.hpp
new file mode 100644
index 0000000000..5019bcdf84
--- /dev/null
+++ b/qt/atlas_location.hpp
@@ -0,0 +1,13 @@
+// Korea SOS Atlas Kit modification, 2026-11-14. Apache-2.0.
+#pragma once
+
+#include <cstdint>
+
+namespace qt
+{
+// Clock rollback or a future provider timestamp must never authorize live navigation.
+constexpr bool AtlasHasFreshFix(bool received, int64_t timestamp, int64_t now)
+{
+  return received && timestamp > 0 && timestamp <= now && now - timestamp <= 15;
+}
+}  // namespace qt
diff --git a/qt/atlas_location_tests.cpp b/qt/atlas_location_tests.cpp
new file mode 100644
index 0000000000..ab08120804
--- /dev/null
+++ b/qt/atlas_location_tests.cpp
@@ -0,0 +1,10 @@
+// Korea SOS Atlas Kit modification, 2026-11-14. Apache-2.0.
+#include "atlas_location.hpp"
+
+static_assert(!qt::AtlasHasFreshFix(false, 100, 100));
+static_assert(!qt::AtlasHasFreshFix(true, 0, 10));
+static_assert(qt::AtlasHasFreshFix(true, 100, 100));
+static_assert(qt::AtlasHasFreshFix(true, 100, 115));
+static_assert(!qt::AtlasHasFreshFix(true, 100, 116));
+static_assert(!qt::AtlasHasFreshFix(true, 100, 99));
+int main() {}
diff --git a/qt/atlas_navigation.cpp b/qt/atlas_navigation.cpp
new file mode 100644
index 0000000000..92321b1d63
--- /dev/null
+++ b/qt/atlas_navigation.cpp
@@ -0,0 +1,209 @@
+// Korea SOS Atlas Kit modification, 2026-11-14. Apache-2.0; upstream notices retained.
+#include "qt/mainwindow.hpp"
+#include "qt/atlas_location.hpp"
+#include "qt/draw_widget.hpp"
+#include "map/framework.hpp"
+#include "geometry/mercator.hpp"
+#include "routing/route.hpp"
+#include <QtCore/QDateTime>
+#include <QtCore/QTimer>
+#include <QtCore/QFile>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <cmath>
+#include <QtWidgets/QComboBox>
+#include <QtWidgets/QDockWidget>
+#include <QtWidgets/QLabel>
+#include <QtWidgets/QListWidget>
+#include <QtWidgets/QPushButton>
+#include <QtWidgets/QVBoxLayout>
+
+namespace qt
+{
+void MainWindow::CreateAtlasNavigation()
+{
+  auto * dock = new QDockWidget(tr("Route and location"), this);
+  dock->setFeatures(QDockWidget::NoDockWidgetFeatures);
+  auto * panel = new QWidget(dock);
+  auto * layout = new QVBoxLayout(panel);
+  m_atlasGps = new QLabel(tr("GPS: no position received"), panel);
+  m_atlasGps->setWordWrap(true);
+  m_atlasEndpoints = new QLabel(tr("Select a place, then choose Start or Destination."), panel);
+  m_atlasEndpoints->setWordWrap(true);
+  m_atlasMode = new QComboBox(panel);
+  m_atlasMode->setObjectName("atlasTravelMode");
+  m_atlasMode->addItem(tr("Walking"), static_cast<int>(routing::RouterType::Pedestrian));
+  m_atlasMode->addItem(tr("Driving"), static_cast<int>(routing::RouterType::Vehicle));
+  auto & manager = GetFramework().GetRoutingManager();
+  manager.SetRouter(routing::RouterType::Pedestrian);
+  connect(m_atlasMode, &QComboBox::currentIndexChanged, this, [this](int)
+  {
+    auto & rm = GetFramework().GetRoutingManager();
+    rm.SetRouter(static_cast<routing::RouterType>(m_atlasMode->currentData().toInt()));
+    m_atlasSteps->clear();
+    if (rm.GetRoutePoints().size() >= 2) rm.BuildRoute();
+  });
+  auto * current = new QPushButton(tr("Start from current position"), panel);
+  connect(current, &QPushButton::clicked, this, [this]
+  {
+    if (!AtlasHasFreshFix(m_atlasHasFix, m_atlasFixTime, QDateTime::currentSecsSinceEpoch()))
+    { m_locationService->Start(); m_atlasGps->setText(tr("No fresh GPS position. Select a start on the map.")); return; }
+    RouteMarkData point;
+    point.m_pointType = RouteMarkType::Start;
+    point.m_isMyPosition = true;
+    point.m_position = mercator::FromLatLon(m_atlasFix.GetLatLon());
+    point.m_title = tr("Current position").toStdString();
+    auto & rm = GetFramework().GetRoutingManager();
+    rm.AddRoutePoint(std::move(point));
+    if (rm.GetRoutePoints().size() >= 2) rm.BuildRoute();
+    OnMyPosition();
+  });
+  auto * build = new QPushButton(tr("Find route"), panel);
+  connect(build, &QPushButton::clicked, this, [this]
+  {
+    auto & rm = GetFramework().GetRoutingManager();
+    if (rm.GetRoutePoints().size() >= 2) rm.BuildRoute();
+    else m_atlasStatus->setText(tr("Choose both start and destination."));
+  });
+  auto * follow = new QPushButton(tr("Follow current position"), panel);
+  connect(follow, &QPushButton::clicked, this, [this]
+  {
+    if (!AtlasHasFreshFix(m_atlasHasFix, m_atlasFixTime, QDateTime::currentSecsSinceEpoch()))
+    { m_locationService->Start(); m_atlasGps->setText(tr("No fresh GPS position. Select a start on the map.")); return; }
+    auto & rm = GetFramework().GetRoutingManager();
+    if (!rm.IsRouteBuilt()) { m_atlasStatus->setText(tr("Find a route first.")); return; }
+    auto const points = rm.GetRoutePoints();
+    if (points.empty() || !points.front().m_isMyPosition)
+    { m_atlasStatus->setText(tr("Use Start from current position before following.")); return; }
+    rm.FollowRoute();
+  });
+  auto * clear = new QPushButton(tr("Clear route"), panel);
+  connect(clear, &QPushButton::clicked, this, &MainWindow::OnClearRoute);
+  auto * saved = new QPushButton(tr("Saved places"), panel);
+  connect(saved, &QPushButton::clicked, this, &MainWindow::OnBookmarksAction);
+  m_atlasStatus = new QLabel(tr("Choose both start and destination."), panel);
+  m_atlasStatus->setWordWrap(true);
+  m_atlasSteps = new QListWidget(panel);
+  m_atlasSteps->setWordWrap(true);
+  layout->addWidget(m_atlasGps);
+  layout->addWidget(current);
+  layout->addWidget(m_atlasEndpoints);
+  auto * pointHelp = new QLabel(tr("Select an icon; right-click any other point on the map."), panel);
+  pointHelp->setWordWrap(true);
+  layout->addWidget(pointHelp);
+  layout->addWidget(m_atlasMode);
+  layout->addWidget(build);
+  layout->addWidget(follow);
+  layout->addWidget(clear);
+  layout->addWidget(saved);
+  layout->addWidget(m_atlasStatus);
+  layout->addWidget(new QLabel(tr("Steps: distance from start"), panel));
+  layout->addWidget(m_atlasSteps);
+  auto * notice = new QLabel(tr("Offline map: closures and hazards are not live."), panel);
+  notice->setWordWrap(true);
+  layout->addWidget(notice);
+  auto * credit = new QLabel("Map data © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> and <a href=\"https://organicmaps.app\">Organic Maps</a>", panel);
+  credit->setOpenExternalLinks(true);
+  credit->setWordWrap(true);
+  layout->addWidget(credit);
+  auto * projectCredit = new QLabel("<a href=\"https://organicmaps.app\">Organic Maps Project</a>", panel);
+  projectCredit->setOpenExternalLinks(true);
+  layout->addWidget(projectCredit);
+  dock->setWidget(panel);
+  dock->setMinimumWidth(290);
+  addDockWidget(Qt::LeftDockWidgetArea, dock);
+  auto * timer = new QTimer(this);
+  connect(timer, &QTimer::timeout, this, &MainWindow::UpdateAtlasNavigation);
+  timer->start(1000);
+}
+
+void MainWindow::UpdateAtlasNavigation()
+{
+  auto & rm = GetFramework().GetRoutingManager();
+  // Local handoff from the reviewed SOS facility catalog. No online geocoding.
+  auto const requestPath = qEnvironmentVariable("SOS_ATLAS_REQUEST");
+  QFile request(requestPath);
+  if (!requestPath.isEmpty() && request.exists() && request.size() < 8192 && request.open(QIODevice::ReadOnly))
+  {
+    auto const data = QJsonDocument::fromJson(request.readAll()).object();
+    request.close();
+    request.remove();
+    double const lat = data.value("lat").toDouble(0), lon = data.value("lon").toDouble(0);
+    auto const name = data.value("name").toString();
+    if (std::isfinite(lat) && std::isfinite(lon) && lat >= 33 && lat <= 39 && lon >= 124 && lon <= 132 && !name.isEmpty())
+    {
+      RouteMarkData target;
+      target.m_pointType = RouteMarkType::Finish;
+      target.m_position = mercator::FromLatLon(lat, lon);
+      target.m_title = name.toStdString();
+      auto const position = target.m_position;
+      rm.AddRoutePoint(std::move(target));
+      GetFramework().ShowRect(mercator::RectByCenterXYAndSizeInMeters(position, 1000));
+      if (rm.GetRoutePoints().size() >= 2) rm.BuildRoute();
+      raise();
+      activateWindow();
+    }
+  }
+  if (!AtlasHasFreshFix(m_atlasHasFix, m_atlasFixTime, QDateTime::currentSecsSinceEpoch()) && rm.IsRoutingFollowing())
+    rm.DisableFollowMode();
+  QString start = tr("Not selected"), finish = start;
+  for (auto const & p : rm.GetRoutePoints())
+  {
+    auto const ll = mercator::ToLatLon(p.m_position);
+    QString name = QString::fromStdString(p.m_title);
+    if (name.isEmpty()) name = QString("%1, %2").arg(ll.m_lat, 0, 'f', 5).arg(ll.m_lon, 0, 'f', 5);
+    if (p.m_pointType == RouteMarkType::Start) start = p.m_isMyPosition ? tr("Current position") : name;
+    if (p.m_pointType == RouteMarkType::Finish) finish = name;
+  }
+  m_atlasEndpoints->setText(tr("Start: %1\nDestination: %2").arg(start, finish));
+  {
+    auto const selected = m_atlasMode->findData(static_cast<int>(rm.GetRouter()));
+    if (selected >= 0 && selected != m_atlasMode->currentIndex())
+    { m_atlasMode->blockSignals(true); m_atlasMode->setCurrentIndex(selected); m_atlasMode->blockSignals(false); }
+  }
+  if (m_atlasHasFix)
+  {
+    auto const age = QDateTime::currentSecsSinceEpoch() - m_atlasFixTime;
+    m_atlasGps->setText((!AtlasHasFreshFix(m_atlasHasFix, m_atlasFixTime, QDateTime::currentSecsSinceEpoch()) ? tr("GPS stale (%1 seconds). Last position: %2, %3") : tr("GPS received (%1 seconds ago): %2, %3"))
+      .arg(age).arg(m_atlasFix.m_latitude, 0, 'f', 5).arg(m_atlasFix.m_longitude, 0, 'f', 5)
+      + tr("\nAccuracy: %1 m").arg(m_atlasFix.m_horizontalAccuracy, 0, 'f', 0));
+  }
+  if (rm.IsRouteBuilding()) { m_atlasStatus->setText(tr("Calculating route...")); m_atlasSteps->clear(); return; }
+  auto const * route = rm.RoutingSession().GetRoute();
+  if (!rm.IsRouteBuilt() || !route)
+  {
+    m_atlasSteps->clear();
+    if (rm.GetRoutePoints().empty()) m_atlasStatus->setText(tr("Choose both start and destination."));
+    else if (rm.GetRoutePoints().size() >= 2) m_atlasStatus->setText(tr("Route unavailable. Check points and installed maps."));
+    return;
+  }
+  bool const walking = rm.GetRouter() == routing::RouterType::Pedestrian;
+  QString mode = walking ? tr("Walking") : tr("Driving");
+  if (rm.GetRouter() == routing::RouterType::Bicycle) mode = tr("Cycling");
+  if (rm.GetRouter() == routing::RouterType::Transit) mode = tr("Transit");
+  if (rm.GetRouter() == routing::RouterType::Ruler) mode = tr("Ruler");
+  QString status = tr("%1 · %2 km · about %3 min").arg(mode)
+    .arg(route->GetTotalDistanceMeters() / 1000, 0, 'f', 2).arg(static_cast<int>(route->GetTotalTimeSec() / 60 + 0.5));
+  if (rm.IsRoutingFollowing())
+  {
+    routing::FollowingInfo info;
+    rm.GetRouteFollowingInfo(info);
+    if (info.IsValid()) status += tr("\nRemaining: %1").arg(QString::fromStdString(info.m_distToTarget.ToString()));
+  }
+  m_atlasStatus->setText(status);
+  QStringList steps;
+  for (auto const & segment : route->GetRouteSegments())
+  {
+    auto const & turn = segment.GetTurn();
+    if (turn.IsTurnNone()) continue;
+    auto const name = walking ? DebugPrint(turn.m_pedestrianTurn) : DebugPrint(turn.m_turn);
+    auto instruction = QCoreApplication::translate("Atlas", name.c_str());
+    if (turn.m_exitNum > 0) instruction += tr(" (exit %1)").arg(turn.m_exitNum);
+    steps << QString("%1 m · %2 · %3").arg(segment.GetDistFromBeginningMeters(), 0, 'f', 0)
+      .arg(instruction, QString::fromStdString(segment.GetRoadNameInfo().m_name));
+  }
+  if (steps.join('\n') != m_atlasStepText)
+  { m_atlasStepText = steps.join('\n'); m_atlasSteps->clear(); m_atlasSteps->addItems(steps); }
+  else if (m_atlasSteps->count() == 0) m_atlasSteps->addItems(steps);
+}
+} // namespace qt
