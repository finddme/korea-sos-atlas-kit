 {
 bool GetUserWritableDir(std::string & outDir)
 {
+  // Korea SOS Atlas Kit modification (2026-11-24): a portable kit keeps the
+  // viewer's settings next to it instead of in the user profile.
+  if (char const * dir = std::getenv("SOS_ATLAS_SETTINGS_DIR"); dir != nullptr && *dir != '\0')
+  {
+    outDir = dir;
+    if (outDir.back() != '\\' && outDir.back() != '/')
+      outDir += '\\';
+    return Platform::MkDirRecursively(outDir);
+  }
+
   char pathBuf[MAX_PATH] = {};
   if (FAILED(::SHGetFolderPathA(nullptr, CSIDL_LOCAL_APPDATA, nullptr, SHGFP_TYPE_CURRENT, pathBuf)))
