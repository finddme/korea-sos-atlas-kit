+// Korea SOS Atlas Kit modification, 2026-11-14. Apache-2.0.
+#pragma once
+
+#include <cstdint>
+
+namespace qt
+{
+// Clock rollback or a future provider timestamp must never authorize live navigation.
+constexpr bool AtlasHasFreshFix(bool received, int64_t timestamp, int64_t now)
+{
+  return received && timestamp > 0 && timestamp <= now && now - timestamp <= 15;
+}
+}  // namespace qt
